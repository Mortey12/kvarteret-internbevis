{
    "name": "kvarteret-internbevis-rn",
    "version": "1.0.0",
    "main": "expo-router/entry",
    "scripts": {
        "start": "expo start",
        "start:dev-client": "expo start --dev-client",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "build:dev:android": "eas build --platform android --profile development-android",
        "build:dev:ios": "eas build --platform ios --profile development-ios",
        "build:dev:ios-simulator": "eas build --platform ios --profile development-ios-simulator",
        "update:production": "eas update --channel production --environment production",
        "update:preview": "eas update --channel preview --environment preview",
        "workflow:dev-builds": "eas workflow:run .eas/workflows/create-development-builds.yml --wait",
        "api:generate": "npm run api:generate:events",
        "api:generate:events": "node scripts/generate-samfunnet-events-client.mjs",
        "api:generate:personal": "node scripts/generate-kvarteret-personal-client.mjs",
        "api:check": "npm run api:check:events",
        "api:check:events": "node scripts/generate-samfunnet-events-client.mjs --check",
        "api:check:personal": "node scripts/generate-kvarteret-personal-client.mjs --check",
        "test": "jest",
        "test:watch": "jest --watch",
        "check:style-exceptions": "bash ./scripts/check-style-exceptions.sh",
        "lint": "biome lint .",
        "lint:ci": "npm run check:style-exceptions && biome lint .",
        "format": "biome format --write .",
        "biome:check": "biome check .",
        "lint:architecture": "depcruise src --config .dependency-cruiser.cjs"
    },
    "dependencies": {
        "@expo/vector-icons": "^15.0.3",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-navigation/native": "^7.1.8",
        "@react-navigation/native-stack": "^7.3.16",
        "@tanstack/react-query": "^5.90.21",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "expo": "^55.0.4",
        "expo-blur": "~55.0.8",
        "expo-clipboard": "~55.0.8",
        "expo-constants": "~55.0.7",
        "expo-dev-client": "~55.0.10",
        "expo-font": "~55.0.4",
        "expo-glass-effect": "~55.0.7",
        "expo-haptics": "~55.0.8",
        "expo-image": "~55.0.5",
        "expo-insights": "~55.0.10",
        "expo-linking": "~55.0.7",
        "expo-localization": "~55.0.8",
        "expo-router": "~55.0.3",
        "expo-secure-store": "~55.0.8",
        "expo-sensors": "~55.0.8",
        "expo-splash-screen": "~55.0.10",
        "expo-status-bar": "~55.0.4",
        "expo-updates": "~55.0.12",
        "i18next": "^25.8.5",
        "posthog-react-native": "4.68.5",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-i18next": "^16.5.4",
        "react-native": "0.83.2",
        "react-native-gesture-handler": "~2.30.0",
        "react-native-markdown-display": "^7.0.2",
        "react-native-paper": "^5.15.0",
        "react-native-reanimated": "4.2.1",
        "react-native-render-html": "^6.3.4",
        "react-native-safe-area-context": "~5.6.0",
        "react-native-screens": "~4.23.0",
        "react-native-worklets": "0.7.2",
        "tailwind-merge": "^3.4.0",
        "uniwind": "^1.4.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.14",
        "@hey-api/openapi-ts": "^0.96.1",
        "@testing-library/react-native": "13.3.3",
        "@types/jest": "29.5.14",
        "@types/react": "~19.2.10",
        "@types/react-test-renderer": "19.1.0",
        "babel-plugin-module-resolver": "^5.0.2",
        "babel-preset-expo": "~55.0.8",
        "dependency-cruiser": "^18.0.0",
        "jest": "~29.7.0",
        "jest-expo": "~55.0.9",
        "react-test-renderer": "19.2.0",
        "tailwindcss": "^4.2.1",
        "typescript": "~5.9.3"
    },
    "overrides": {
        "glob": "^13.0.0",
        "markdown-it": "12.3.2",
        "minimatch": "^10.2.2"
    },
    "expo": {},
    "private": true
}

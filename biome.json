{
    "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!.claude",
            "!coverage",
            "!docs",
            "!dist",
            "!node_modules",
            "!uniwind-types.d.ts",
            "!**/*.css"
        ],
        "ignoreUnknown": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "complexity": {
                "useArrowFunction": "warn"
            },
            "style": {
                "useImportType": "off"
            }
        }
    },
    "assist": {
        "enabled": true
    },
    "overrides": [
        {
            "includes": ["src/core/api/samfunnet-events/**", "src/core/api/kvarteret-personal/**"],
            "linter": {
                "enabled": false
            },
            "assist": {
                "enabled": false
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "jsxQuoteStyle": "double",
            "semicolons": "asNeeded",
            "trailingCommas": "all",
            "arrowParentheses": "asNeeded"
        }
    }
}
